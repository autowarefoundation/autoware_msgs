# See
# https://github.com/autowarefoundation/autoware_core/tree/main/localization/autoware_pose_initializer
# https://docs.autoware.org/main/design/autoware-architecture-v1/interfaces/ad-api/features/localization/
# for the use-cases of this service

# constants for specifying initialization method
# The initial position is automatically estimated with localization algorithm
uint8 AUTO = 0
# The initial position is set directly by the input pose without going through localization algorithm
uint8 DIRECT = 1

# Input pose used as an initial guess (AUTO) or as the initial position itself (DIRECT) (optional)
# default: not provided (empty array)
geometry_msgs/PoseWithCovarianceStamped[<=1] pose_with_covariance

# Variable to set initialization method (required)
# AUTO: The initial position is automatically estimated with localization algorithm.
#       The input pose will be used as an initial guess if provided.
# DIRECT: The initial position is set directly by the input pose without going through localization algorithm.
uint8 method
---
# ERROR CODES used in response status in case of failure
# The vehicle is not stopped, so it is unsafe to initialize the pose
uint16 ERROR_UNSAFE = 1
# GNSS-based initialization is not supported (e.g. no GNSS module is available)
uint16 ERROR_GNSS_SUPPORT = 2
# The GNSS pose has not arrived yet, or is out of date
uint16 ERROR_GNSS = 3
# The pose estimation (e.g. alignment or localization trigger) failed
uint16 ERROR_ESTIMATION = 4

# Result status of the initialization request. On failure, one of the ERROR CODES above is set. (required)
autoware_common_msgs/ResponseStatus status
